# Core runtime
NODE_ENV=development
STALLONE_NAME=Arnold
STALLONE_WORKSPACE_ROOT=/Users/aritrarpal/Documents/workspace_biz
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/localclaw
DATABASE_SCHEMA=surgical_orchestrator

# Security (P3 Protocol)
ENCRYPTION_KEY=YOUR_SECURE_32_CHAR_ENCRYPTION_KEY_HERE

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini (Latest May 2026 GA)
GEMINI_API_KEY=
MODEL_PLANNER=gemini-3.1-pro
MODEL_CODER=gemini-3.5-flash

# Ollama (Local Backup)
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_ROUTER=llama3.2:3b
MODEL_VERIFIER=qwen2.5-coder:7b

# Control API
CONTROL_API_TOKEN=arnold-dev-token
CONTROL_API_PORT=3000
CONTROL_API_HOST=127.0.0.1

# Features
AUTO_RESUME_ENABLED=true
MEMORY_RETENTION_ENABLED=true
